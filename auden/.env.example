# Copy to .env.local and fill in. Never commit real values.

# ---- Data backend: "local" (dev/test, JSON file) or "supabase" (production)
AUDEN_BACKEND=local
# Local backend data file (dev only)
AUDEN_LOCAL_DATA_FILE=.data/auden-dev.json

# ---- Supabase (when AUDEN_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Model providers
# Default provider when no key is configured is the mock provider.
OPENROUTER_API_KEY=
# Optional: comma-separated OpenRouter model ids per mode. Only free models are accepted.
# Leave empty to auto-select from OpenRouter's catalogue of free models.
AUDEN_MODELS_AIR=
AUDEN_MODELS_CORE=
AUDEN_MODELS_PRIME=
# Public URL of the app, sent to OpenRouter as HTTP-Referer (optional)
AUDEN_APP_URL=

# Optional self-hosted OpenAI-compatible server (vLLM, Ollama, LM Studio...)
# AUDEN_CUSTOM_BASE_URL=http://localhost:8000/v1
# AUDEN_CUSTOM_API_KEY=
# AUDEN_CUSTOM_MODELS=my-model
# AUDEN_CUSTOM_MODES=prime            # modes routed to the custom server first

# ---- Limits (server-side)
AUDEN_USER_DAILY_MESSAGES=40
AUDEN_USER_PER_MINUTE=6
AUDEN_GLOBAL_DAILY_REQUESTS=45
AUDEN_MAX_INPUT_CHARS=8000

# Sign-ups: open | allowlist | closed. Closed alpha: allowlist + AUDEN_ALLOWED_EMAILS.
# With Supabase, also add the emails to public.signup_allowlist and set app_config.signup_mode
# (the database enforces it, so direct sign-ups through the Supabase API are blocked too).
AUDEN_SIGNUP_MODE=open
# Comma-separated emails or whole domains: alice@example.com,@mycompany.com
AUDEN_ALLOWED_EMAILS=
# Trust X-Forwarded-For from the hosting proxy for per-IP auth rate limits
AUDEN_TRUST_PROXY=true
# Auth rate limits (per server instance; Supabase Auth adds its own)
AUDEN_AUTH_FAILS_PER_EMAIL=5
AUDEN_AUTH_FAILS_PER_IP=30
AUDEN_SIGNUPS_PER_IP_HOUR=5
